# Python / ML Project .gitignore for BHID

# Virtual Environments
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment & Config secrets
.env
.env.*
!.env.example

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Data directories (raw, processed, features, external)
data/raw/
data/processed/
data/features/
data/external/

# Model binaries & checkpoints
models/pretrained/
models/trained/
models/evaluation/

# Media / Video formats
*.mp4
*.avi
*.mov
*.mkv

# ML Weights & Model Formats
*.pt
*.pth
*.onnx
*.pkl
*.joblib

# OS metadata
.DS_Store
Thumbs.db
